{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PracticeTab",
  "version": "1.5.0",
  "identifier": "practicetab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PracticeTab",
        "width": 1400,
        "height": 750,
        "minWidth": 1280,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/soundfonts/default.sf2"],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
