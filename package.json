{
  "name": "practicetab",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "pnpm typecheck && vitest",
    "test:run": "pnpm typecheck && vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.0",
    "@noble/hashes": "^2.0.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "chart.js": "^4.5.1",
    "dompurify": "^3.2.7",
    "driver.js": "^1.4.0",
    "lucide-vue-next": "^0.562.0",
    "marked": "^15.0.12",
    "pinia": "^3.0.3",
    "reka-ui": "^2.7.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.18",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "happy-dom": "^20.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.0.3",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{js,ts,vue,json,css,scss,md}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src-tauri/**/*.{rs}": [
      "bash -lc 'cd src-tauri && cargo fmt'"
    ]
  }
}
